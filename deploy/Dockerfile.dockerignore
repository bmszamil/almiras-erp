# Build-context filter for deploy/Dockerfile (BuildKit reads <Dockerfile>.dockerignore next to the Dockerfile).
# Keep secrets, local data and tooling out of the image.
.git
.github
.claude
**/__pycache__
**/*.pyc
.pytest_cache
db.sqlite3
*.sqlite3
.env
*.env
deploy/secrets
deploy/env
deploy/*.env
deploy/**/*.key
deploy/**/*.pem
deploy/**/*.age
deploy/**/*.agekey
docs
testdocs
