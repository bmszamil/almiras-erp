# Site settings for docker compose (copy to deploy/.env on the KSA host; .env is git-ignored).
# NO SECRET GOES IN THIS FILE: passwords, keys and tokens are files in deploy/secrets/ (README "Secrets").
# Every value below is a placeholder.

# Public name of the ERP (DNS record pointing at the KSA VM; TLS certificate in secrets/tls/ must match).
ALMIRAS_DOMAIN=erp.example.invalid

# Optional: limit the site to office / VPN ranges (space-separated CIDRs). Default: open to all.
# ALMIRAS_ALLOWED_CIDRS=192.0.2.0/24 198.51.100.0/24

# Images (built locally by "docker compose build"; set a registry tag when you use a KSA-hosted registry).
ALMIRAS_IMAGE=almiras-erp:local
ALMIRAS_POSTGRES_IMAGE=almiras-postgres:16

# Host directories (on the encrypted data disk; a separate disk for backups is recommended).
ALMIRAS_BACKUP_ROOT=/srv/almiras/backups
ALMIRAS_OPENBAO_AUDIT_DIR=/srv/almiras/openbao-audit
ALMIRAS_BACKEND_SUBNET=172.30.20.0/24

# Backups.
ALMIRAS_WAL_ARCHIVING=off
BACKUP_RETENTION_DAILY_DAYS=35
BACKUP_RETENTION_MONTHLY_DAYS=400
BACKUP_RETENTION_BASE_DAYS=15
BACKUP_RETENTION_OPENBAO_DAYS=35

# Mail: the group's KSA-hosted SMTP server (Django mail and Alertmanager; also set it in
# monitoring/alertmanager.yml). Password: secrets/smtp_password.
DJANGO_EMAIL_HOST=mail.example.invalid
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=erp@example.invalid
DJANGO_DEFAULT_FROM_EMAIL=erp@example.invalid

# Web.
GUNICORN_WORKERS=3

# ZATCA endpoints: from ZATCA's developer portal / Swagger at deployment (zatca OQ-30). Empty = not configured.
ZATCA_SANDBOX_BASE_URL=
ZATCA_SIMULATION_BASE_URL=
ZATCA_PRODUCTION_BASE_URL=
# R-29: production submission only where explicitly switched on, at go-live (zatca OQ-1).
ZATCA_PRODUCTION_ALLOWED=0

# Optional KSA-hosted webhook for scheduler job failures (e.g. the company's own chat server). Not a secret
# unless it embeds a token; then put it in secrets/ and use ALMIRAS_ALERT_WEBHOOK_URL_FILE instead.
ALMIRAS_ALERT_WEBHOOK_URL=
